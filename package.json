{
  "name": "mc-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test server/tests/validator.test.js server/tests/downloader.test.js tests/mobile_extractor.test.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.js",
    "desktop:dev": "concurrently -k \"npm run server\" \"npm run client\" \"wait-on http-get://127.0.0.1:5050/api/health http://127.0.0.1:3000 && electron electron/main.js\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug && cd .. && node bin/copy-apk.js debug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease && cd .. && node bin/copy-apk.js release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.7.9",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.475.0",
    "node-fetch": "^3.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mcmusic.desktop",
    "productName": "MC-Music",
    "compression": "store",
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/logo.png",
      "target": [
        "nsis"
      ],
      "artifactName": "MC-Music-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MC-Music"
    }
  }
}
